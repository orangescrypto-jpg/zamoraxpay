# ─────────────────────────────────────────────────────────────────
# ZAMORAXPAY — Environment Variables
# Copy to .env.local and fill in all values.
# NEVER commit .env.local to git.
#
# NOTE: Most provider keys below can ALSO be set/overridden by an admin
# from the Admin Panel (Providers page), which stores them encrypted in
# D1 (see migrations/0002_provider_credentials.sql). Env vars here act
# as the initial/fallback source — whichever is present in D1 wins at
# runtime. This lets you rotate or add keys without a redeploy.
# ─────────────────────────────────────────────────────────────────

# ── Supabase (Auth) — SEPARATE project from Zamorax Marketplace ───
NEXT_PUBLIC_SUPABASE_URL=https://your-zamoraxpay-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Cloudflare D1 (Database) — SEPARATE database from Zamorax ─────
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CF_API_TOKEN=your_cloudflare_api_token_with_d1_edit_permission

# ── Cloudflare R2 (File Storage — banners, page images, receipts) ─
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=zamoraxpay-files
R2_PUBLIC_URL=https://files.zamoraxpay.com.ng
NEXT_PUBLIC_R2_PUBLIC_URL=https://files.zamoraxpay.com.ng
NEXT_PUBLIC_R2_HOSTNAME=files.zamoraxpay.com.ng

# ── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=ZamoraxPay <noreply@zamoraxpay.com.ng>

# ── Signup / verification ───────────────────────────────────────────
# There is no OTP step and no SMS provider in this app. Phone number is
# collected as a plain profile field only — it is never verified.
# Email verification (if you want it) is a Supabase project setting,
# NOT an env var here: Supabase dashboard > Authentication > Settings
# > "Confirm email". Toggle it on/off there; this app reads whatever
# that setting produces (a confirmed or unconfirmed user) and reacts
# accordingly — no code change or redeploy needed to change it.

# ── App URL ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://zamoraxpay.com.ng
NEXT_PUBLIC_ZAMORAX_MARKETPLACE_URL=https://zamorax.com

# ── Shared payment account tag ──────────────────────────────────────
# If Korapay/Paystack are the SAME merchant account as Zamorax
# Marketplace, this tag is attached to every ZamoraxPay transaction's
# metadata (so you can filter this platform's transactions in the
# Paystack/Korapay dashboard) AND is checked by both webhook handlers
# before crediting any wallet — this is what stops a Marketplace
# transaction from ever being processed as a ZamoraxPay one, or vice
# versa, since both apps share one webhook secret. Keep this value
# identical across every environment (local, staging, production).
NEXT_PUBLIC_SITE_TAG=zamoraxpay.com.ng

# ── Cron protection (for /api/cron/auto-reload) ────────────────────
# Set this to a random secret string, and configure your scheduler
# (Vercel Cron, Cloudflare Cron Trigger, GitHub Actions, etc.) to send
# it as "Authorization: Bearer <value>" when calling the cron endpoint.
CRON_SECRET=

# ── Payment Providers (both active, admin can toggle priority) ────
# Korapay — primary (bank transfer / virtual account)
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_WEBHOOK_SECRET=

# Paystack — fallback (card)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── VTU Providers (4 total — admin toggles which are enabled + order) ──
# 1. CheapDataHub
CHEAPDATAHUB_API_KEY=
CHEAPDATAHUB_BASE_URL=https://api.cheapdatahub.ng/v1

# 2. Pairgate
PAIRGATE_API_KEY=
PAIRGATE_BASE_URL=https://api.pairgate.com/v1

# 3. VTpass
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_BASE_URL=https://vtpass.com/api

# 4. VTU.ng
VTUNG_API_KEY=
VTUNG_SECRET_KEY=
VTUNG_BASE_URL=https://vtu.ng/wp-json/api/v2

# ── BVN Verification (reseller tier gate — stub until traffic justifies it) ──
# Admin can set the provider + key from the Admin Panel once ready.
# Leave blank to keep the stub/placeholder verifier active.
BVN_VERIFICATION_PROVIDER=stub
BVN_VERIFICATION_API_KEY=

# ── Sentry (optional error tracking) ───────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
